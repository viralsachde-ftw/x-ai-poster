# ── X session cookies (for posting) ──────────────────────────────────
# Get from browser: F12 > Application > Cookies > https://x.com
# Copy auth_token and ct0 values. Last ~12 months.
X_AUTH_TOKEN=
X_CT0=

# ── xAI / Grok API key (for post generation) ────────────────────────
# Get from https://console.x.ai/
XAI_API_KEY=

# ── Cron secret ──────────────────────────────────────────────────────
# Any random string to protect cron endpoints from unauthorized calls
CRON_SECRET=

# ── Redis (for storage) ─────────────────────────────────────────────
# Required for: daily auto-posts, duplicate detection, post history
# Works with ANY redis provider: Redis Cloud, Upstash, Railway, etc.
# Just set REDIS_URL — connects directly via TCP, no REST API needed
# Format: redis://default:password@hostname:port
#         rediss://default:password@hostname:port  (TLS)
REDIS_URL=

# ── Residential proxy (optional) ─────────────────────────────────────
# Only needed if you get AUTOMATION_DETECTED errors
# Format: http://username:password@host:port
PROXY_URL=
