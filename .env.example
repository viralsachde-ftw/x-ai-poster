# ── x-automation service (posting to X without official API) ─────────
# Deploy https://github.com/elnino-hub/x-automation on Render/Railway/Fly.io
# then fill in the URL and the API_KEY you set for that service
X_AUTOMATION_URL=https://your-x-automation-service.onrender.com
X_AUTOMATION_API_KEY=your_x_automation_api_key

# ── xAI / Grok API key (post generation) ────────────────────────
# Get from https://console.x.ai/
XAI_API_KEY=

# ── Cron secret ──────────────────────────────────────────────────────
# Any random string to protect cron endpoints from unauthorized calls
CRON_SECRET=

# ── Vercel KV / Upstash Redis ────────────────────────────────────────
# Required for: daily auto-posts, duplicate detection, post history
# Get from Vercel Dashboard > Storage > KV (free tier)
KV_REST_API_URL=
KV_REST_API_TOKEN=
